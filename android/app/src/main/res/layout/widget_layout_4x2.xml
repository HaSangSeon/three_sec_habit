<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_4x2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- 상단 헤더: 타이틀 & 진행 요약 (탭하면 앱 실행) -->
    <LinearLayout
        android:id="@+id/widget_4x2_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_4x2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ 3초 습관 · 오늘 체크리스트"
            android:textColor="#C084FC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_4x2_progress_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 0 완료 (0%)"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="4dp"
        android:background="#334155" />

    <!-- 오늘 예정된 모든 습관을 스크롤하여 보여주는 리스트뷰 -->
    <ListView
        android:id="@+id/widget_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="vertical" />

    <!-- 습관이 없을 때 표시되는 뷰 -->
    <TextView
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="오늘 예정된 습관이 없습니다 🎉"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
